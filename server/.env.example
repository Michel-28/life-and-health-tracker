# ========================================================
# LIFE & HEALTH TRACKER - SERVER ENVIRONMENT CONFIGURATION
# ========================================================
# Copy this file to .env and replace placeholder values with your real credentials.
# IMPORTANT: Never commit your real .env file or database passwords to Git!

# Server Port & Environment
PORT=5000
NODE_ENV=production

# MongoDB Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/life_health_tracker
# MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@<cluster-address>/life_health_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/life_health_tracker?retryWrites=true&w=majority

# JWT Authentication
# Generate a strong 64-character random string for production
JWT_SECRET=your_super_secret_jwt_random_string_here_min_32_chars
JWT_EXPIRE=30d

# Allowed Frontend URL(s) for CORS
# Comma-separated list of allowed origins, e.g. https://my-life-tracker.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# Optional: Google Gemini API Key for AI Insights
GEMINI_API_KEY=

