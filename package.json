{
  "name": "life-and-health-tracker",
  "version": "1.0.0",
  "description": "Comprehensive MERN Life & Health Tracker Web Application",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server test",
    "start": "node server/src/server.js"
  },
  "keywords": [
    "mern",
    "health-tracker",
    "lifestyle",
    "workout",
    "sleep",
    "nutrition",
    "react",
    "mongodb",
    "express"
  ],
  "author": "Senior Full-Stack Developer",
  "license": "MIT"
}
